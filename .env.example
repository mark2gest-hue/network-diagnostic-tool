# Configurazione Database Turso (LibSQL)
TURSO_DATABASE_URL=libsql://network-diag-db-mark2gest-hue.aws-eu-west-1.turso.io
TURSO_AUTH_TOKEN=your-turso-auth-token

# Autenticazione (JWT)
JWT_SECRET=your-secure-jwt-secret-string-at-least-32-chars

# Note:
# 1. Inserisci TURSO_AUTH_TOKEN e JWT_SECRET nel tuo file .env.local per lo sviluppo locale.
# 2. Inserisci queste variabili nella dashboard Vercel sotto Settings -> Environment Variables.
